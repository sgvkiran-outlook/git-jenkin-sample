	<configuration-properties doc:name="Configuration properties" doc:id="1d610dee-3892-43b9-b4ac-b9c377a022c0" file="myconfig-dev.yaml" />
	<flow name="git-jenkin-sampleFlow" doc:id="7c212d13-51ba-433d-9678-f768ce59b62d" >
